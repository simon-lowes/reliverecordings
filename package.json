{
  "name": "reliverecordings",
  "version": "1.0.0",
  "description": "ReLive Recordings - Live music videography",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all-browsers": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:visual": "playwright test e2e/visual.spec.js",
    "test:visual:update": "playwright test e2e/visual.spec.js --update-snapshots",
    "test:a11y": "playwright test e2e/a11y.spec.js --project=chromium",
    "test:all": "npm run test && npm run test:e2e",
    "validate": "npm run validate:html && npm run validate:css && npm run validate:js",
    "validate:html": "html-validate index.html",
    "validate:css": "stylelint \"css/**/*.css\"",
    "validate:js": "eslint \"js/**/*.js\"",
    "lint": "npm run validate",
    "lint:fix": "stylelint \"css/**/*.css\" --fix && eslint \"js/**/*.js\" --fix",
    "serve": "serve -l 8080"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "html-validate": "^8.26.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.5",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "keywords": [
    "music",
    "videography",
    "live"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "^3.1.3"
  }
}
